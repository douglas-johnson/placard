{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "testflight"
    },
    "production": {
      "extends": "testflight",
      "channel": "production"
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {
      "extends": "testflight"
    }
  }
}
