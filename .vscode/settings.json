{
  // Python lint and format is Ruff (D45). These override user settings for this
  // workspace only: the user-level insertSpaces=false would put tabs into
  // space-indented Python, and autopep8 would otherwise be the formatter on save.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  // The pinned Ruff, so the editor and CI agree on formatting. Falls back to the
  // extension's bundled copy if the venv doesn't exist yet.
  "ruff.path": ["${workspaceFolder}/services/ingest/.venv/bin/ruff"],
  // Ruff covers what Pylint would say here; two linters means duplicate squiggles.
  "pylint.enabled": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/services/ingest/.venv/bin/python",
  "python.analysis.extraPaths": ["tools/lib", "tools/redact"],
  "python.analysis.typeCheckingMode": "standard",

  // The capture app is linted by ESLint and formatted by Prettier (D46). Spaces for
  // the same reason as Python: the user-level insertSpaces=false.
  "[typescript][typescriptreact][javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.rulers": [100]
  },
  // Only format where a Prettier config exists — apps/learner today. Without this
  // the extension would apply its own defaults to .railway/railway.ts.
  "prettier.requireConfig": true,
  // The app isn't at the repository root, so ESLint must be told where its config
  // and node_modules live.
  "eslint.workingDirectories": ["apps/learner"]
}
