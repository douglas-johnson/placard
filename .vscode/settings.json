{
  // Python lint and format is Ruff (D45). These override user settings for this
  // workspace only: the user-level insertSpaces=false would put tabs into
  // space-indented Python, and autopep8 would otherwise be the formatter on save.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  // The pinned Ruff, so the editor and CI agree on formatting. Falls back to the
  // extension's bundled copy if the venv doesn't exist yet.
  "ruff.path": ["${workspaceFolder}/services/ingest/.venv/bin/ruff"],
  // Ruff covers what Pylint would say here; two linters means duplicate squiggles.
  "pylint.enabled": false
}
